{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", ".yarnrc.yml"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "//#test": {
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/.yarnrc.yml",
        "$TURBO_ROOT$/babel.config.js",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/scripts/**"
      ],
      "outputs": ["coverage/**"]
    },
    "@unif/react-native-umeng-example#test": {
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/.yarnrc.yml",
        "$TURBO_ROOT$/babel.config.js",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/example/package.json",
        "$TURBO_ROOT$/example/babel.config.js",
        "$TURBO_ROOT$/example/jest.config.js",
        "$TURBO_ROOT$/example/jest.setup.ts",
        "$TURBO_ROOT$/example/metro.config.js",
        "$TURBO_ROOT$/example/react-native.config.js",
        "$TURBO_ROOT$/example/index.js",
        "$TURBO_ROOT$/example/src/**"
      ],
      "outputs": ["coverage/**"]
    },
    "@unif/react-native-umeng-example#build:android": {
      "env": ["ANDROID_HOME", "ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/.yarnrc.yml",
        "$TURBO_ROOT$/babel.config.js",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/src/**",
        "!$TURBO_ROOT$/src/__tests__/**",
        "!$TURBO_ROOT$/src/**/__tests__/**",
        "!$TURBO_ROOT$/src/*.test.*",
        "!$TURBO_ROOT$/src/**/*.test.*",
        "$TURBO_ROOT$/android/**",
        "$TURBO_ROOT$/example/app.json",
        "$TURBO_ROOT$/example/package.json",
        "$TURBO_ROOT$/example/babel.config.js",
        "$TURBO_ROOT$/example/metro.config.js",
        "$TURBO_ROOT$/example/react-native.config.js",
        "$TURBO_ROOT$/example/index.js",
        "$TURBO_ROOT$/example/src/**",
        "!$TURBO_ROOT$/example/src/__tests__/**",
        "!$TURBO_ROOT$/example/src/**/__tests__/**",
        "!$TURBO_ROOT$/example/src/*.test.*",
        "!$TURBO_ROOT$/example/src/**/*.test.*",
        "$TURBO_ROOT$/example/android/**",
        "!$TURBO_ROOT$/android/build/**",
        "!$TURBO_ROOT$/android/.gradle/**",
        "!$TURBO_ROOT$/example/android/.gradle/**",
        "!$TURBO_ROOT$/example/android/build/**",
        "!$TURBO_ROOT$/example/android/app/build/**"
      ],
      "outputs": []
    },
    "@unif/react-native-umeng-example#build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/yarn.lock",
        "$TURBO_ROOT$/.yarnrc.yml",
        "$TURBO_ROOT$/babel.config.js",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/*.podspec",
        "$TURBO_ROOT$/src/**",
        "!$TURBO_ROOT$/src/__tests__/**",
        "!$TURBO_ROOT$/src/**/__tests__/**",
        "!$TURBO_ROOT$/src/*.test.*",
        "!$TURBO_ROOT$/src/**/*.test.*",
        "$TURBO_ROOT$/ios/**",
        "$TURBO_ROOT$/example/app.json",
        "$TURBO_ROOT$/example/Gemfile",
        "$TURBO_ROOT$/example/Gemfile.lock",
        "$TURBO_ROOT$/example/package.json",
        "$TURBO_ROOT$/example/babel.config.js",
        "$TURBO_ROOT$/example/metro.config.js",
        "$TURBO_ROOT$/example/react-native.config.js",
        "$TURBO_ROOT$/example/index.js",
        "$TURBO_ROOT$/example/src/**",
        "!$TURBO_ROOT$/example/src/__tests__/**",
        "!$TURBO_ROOT$/example/src/**/__tests__/**",
        "!$TURBO_ROOT$/example/src/*.test.*",
        "!$TURBO_ROOT$/example/src/**/*.test.*",
        "$TURBO_ROOT$/example/ios/**",
        "!$TURBO_ROOT$/ios/build/**",
        "!$TURBO_ROOT$/ios/Pods/**",
        "!$TURBO_ROOT$/example/ios/build/**",
        "!$TURBO_ROOT$/example/ios/Pods/**"
      ],
      "outputs": []
    }
  }
}
